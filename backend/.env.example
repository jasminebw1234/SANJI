# Copy this file to .env and fill in real values before running.

# Database (Neon connection string — get this from your Neon project dashboard)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Server
PORT=3001

# Local storage path for Phase 1 (swapped for Cloudflare R2 / Vercel Blob later —
# see src/services/storageAdapter.js)
LOCAL_STORAGE_PATH=./storage

# Mood tagging (per-section tone detection) — get a key at console.anthropic.com
# If unset, uploads still work end-to-end; mood tagging is just skipped
# (moodTaggingStatus: "skipped" in the upload response) and can be run later
# via POST /api/documents/:id/mood-tags once a key is configured.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-opus-5.
# Tone tagging is a simple classification task, so the code already runs it
# at effort "low". If you want it cheaper still, set this to
# claude-haiku-4-5 (roughly 5x cheaper per token). Compare them on a real
# document before deciding: npm run check-moods -- yourfile.pdf
MOOD_TAGGING_MODEL=claude-opus-5

# Voice selection (Phase 2) — get a key at elevenlabs.io
# If unset, upload and mood tagging still work; the voice picker returns a
# 503 telling you to configure this.
ELEVENLABS_API_KEY=
