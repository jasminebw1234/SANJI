# Copy this file to .env and fill in real values before running.

# Database (Neon connection string — get this from your Neon project dashboard)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Server
PORT=3001

# Local storage path for Phase 1 (swapped for Cloudflare R2 / Vercel Blob later —
# see src/services/storageAdapter.js)
LOCAL_STORAGE_PATH=./storage

# Mood tagging (per-section tone detection) — get a key at console.anthropic.com
# If unset, uploads still work end-to-end; mood tagging is just skipped
# (moodTaggingStatus: "skipped" in the upload response) and can be run later
# via POST /api/documents/:id/mood-tags once a key is configured.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-haiku-4-5-20251001, which is plenty for a
# simple per-paragraph tone classification and keeps this cheap per the
# MVP plan's cost estimate.
MOOD_TAGGING_MODEL=claude-haiku-4-5-20251001
